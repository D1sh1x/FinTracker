POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
SITE_ADDRESS=:80
HTTP_BIND=127.0.0.1
HTTP_PORT=8088
HTTPS_PORT=8443
# For a public server: SITE_ADDRESS=finance.example.com, HTTP_BIND=0.0.0.0,
# HTTP_PORT=80, HTTPS_PORT=443. Set DNS before starting Caddy.
# Optional shared login: put the Caddy hash in single quotes and use compose.auth.yml.
# BASIC_AUTH_HASH='$2a$...'
